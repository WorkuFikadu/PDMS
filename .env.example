# ===================================================================
# NPDMS — National Patient Data Management System
# Environment Variables
# FDRE Ministry of Health — IT & Digital Health Directorate
# ===================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env   (or set these in Vercel Project Settings)
#   2. Never commit .env to Git — it contains secrets!
#   3. For local dev, most values can remain commented out (defaults apply)
# ===================================================================

# ── SERVER ──────────────────────────────────────────────────────────
PORT=5000

# ── DATABASE ─────────────────────────────────────────────────────────
# Leave blank to use local SQLite (default for local development)
# Set to your Neon / Supabase / AWS RDS connection string for production
# DATABASE_URL=postgres://user:password@hostname.neon.tech/npdms?sslmode=require

# ── SMS GATEWAY (AfricasTalking / Ethio Telecom) ──────────────────────
# Leave blank to use simulation mode (logs SMS to console + DB, no real SMS sent)
# To activate real SMS: register at https://africastalking.com
# AT_USERNAME=your_africastalking_username
# AT_API_KEY=your_africastalking_api_key
# AT_SENDER_ID=NPDMS-MOH         # Requires pre-registration with AfricasTalking
# AT_SANDBOX=false                # Set to true to use AT sandbox (free test mode)

# ── FAYDA IDENTITY PLATFORM (FDRE National ID) ───────────────────────
# FAYDA_API_URL=https://api.fayda.et
# FAYDA_API_KEY=your_fayda_integration_key

# ── DHIS2 / NHDIS INTEROPERABILITY ───────────────────────────────────
# DHIS2_BASE_URL=https://dhis.moh.gov.et
# DHIS2_USERNAME=npdms_service_account
# DHIS2_PASSWORD=your_dhis2_password

# ── SECURITY ─────────────────────────────────────────────────────────
# JWT_SECRET=change_this_to_a_long_random_secret_in_production
# ADMIN_NOTIFICATION_PHONE=+251911000000  # Security alerts go to this number
